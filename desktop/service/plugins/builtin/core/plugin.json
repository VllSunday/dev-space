{
  "plugin": 1, "id": "core", "name": "Основные виды", "version": "1.0.0",
  "description": "Список, плитки, галерея и лента материалов, свободная доска и навигатор по проекту.",
  "views": [
    { "id": "list", "title": "Список", "level": "zone", "accepts": ["*"], "actions": ["thing.open"], "render": { "type": "parts", "parts": [{ "part": "list" }] } },
    { "id": "tiles", "title": "Плитки", "level": "zone", "accepts": ["*"], "actions": ["thing.open"], "render": { "type": "parts", "parts": [{ "part": "tiles" }] } },
    { "id": "gallery", "title": "Галерея", "level": "zone", "accepts": ["image"], "actions": ["thing.open"], "render": { "type": "parts", "parts": [{ "part": "gallery" }] } },
    { "id": "outline", "title": "Навигатор проекта", "description": "Плотный список досок, зон, документов и задач.", "level": "zone", "accepts": ["*"], "actions": ["thing.open"], "render": { "type": "parts", "parts": [{ "part": "outline" }] } },
    { "id": "material", "title": "Материал", "level": "thing", "accepts": ["note", "file", "link"], "actions": ["thing.open"], "render": { "type": "native", "component": "material" } },
    { "id": "image", "title": "Изображение", "level": "thing", "accepts": ["image"], "actions": ["thing.open"], "render": { "type": "native", "component": "image" } }
  ],
  "boards": [
    { "id": "free", "title": "Свободная доска", "description": "Зоны лежат там, где вы их оставили.", "layout": "free", "look": { "background": "dots", "zone": "card", "density": "cozy" } }
  ]
}
